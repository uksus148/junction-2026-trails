# Copy to .env for local development. Choose a local database password.
POSTGRES_DB=trails
POSTGRES_USER=trails
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
VALKEY_PORT=6379

# Spring Boot API running on the host
API_CORS_ALLOWED_ORIGINS=http://localhost:5173
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:${POSTGRES_PORT}/${POSTGRES_DB}
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}
# Use the Aiven Valkey TLS endpoint with a rediss:// URI in the deployed API.
SPRING_DATA_REDIS_URL=redis://localhost:${VALKEY_PORT}/0
API_VALKEY_CONNECT_TIMEOUT=2s
API_VALKEY_COMMAND_TIMEOUT=2s
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ORS_API_KEY=
ORS_BASE_URL=https://api.heigit.org/openrouteservice
ORS_CONNECT_TIMEOUT=5s
ORS_READ_TIMEOUT=20s

# Python agent
AGENT_VALKEY_URL=redis://localhost:${VALKEY_PORT}/0
AGENT_SESSION_TTL_SECONDS=86400
AGENT_SESSION_MAX_MESSAGES=200
AGENT_VALKEY_CONNECT_TIMEOUT_SECONDS=2
AGENT_VALKEY_SOCKET_TIMEOUT_SECONDS=2
AGENT_CORS_ORIGINS=["http://localhost:5173"]
EXA_API_KEY=
ANTHROPIC_API_KEY=
AGENT_ANTHROPIC_MODEL=claude-haiku-5-5
AGENT_PROVIDER_TIMEOUT_SECONDS=20
AGENT_DISCOVERY_TIMEOUT_SECONDS=60
AGENT_API_BASE_URL=http://localhost:8080
AGENT_API_TIMEOUT_SECONDS=20
AGENT_HANDOFF_TIMEOUT_SECONDS=60
AGENT_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
AGENT_NOMINATIM_USER_AGENT=trego/0.1 (https://github.com/uksus148/trego)
GEMINI_API_KEY=

# Browser-visible service addresses (everything VITE_* ends up in the public bundle — no secrets)
VITE_USE_MOCKS=true
VITE_API_BASE_URL=http://localhost:8080
VITE_AGENT_BASE_URL=http://localhost:8000

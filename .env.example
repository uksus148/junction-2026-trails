# Copy to .env for local development. Choose a local database password.
POSTGRES_DB=trails
POSTGRES_USER=trails
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Spring Boot API running on the host
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:${POSTGRES_PORT}/${POSTGRES_DB}
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}
SPRING_DATA_REDIS_URL=redis://localhost:6379
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ORS_API_KEY=

# Python agent
AGENT_VALKEY_URL=redis://localhost:6379/0
AGENT_SESSION_TTL_SECONDS=86400
AGENT_SESSION_MAX_MESSAGES=200
AGENT_VALKEY_CONNECT_TIMEOUT_SECONDS=2
AGENT_VALKEY_SOCKET_TIMEOUT_SECONDS=2
AGENT_CORS_ORIGINS=["http://localhost:5173"]
EXA_API_KEY=
ANTHROPIC_API_KEY=
AGENT_ANTHROPIC_MODEL=claude-haiku-5-5
AGENT_PROVIDER_TIMEOUT_SECONDS=20
AGENT_NOMINATIM_USER_AGENT=GopstopTrails/0.1 (https://github.com/uksus148/junction-2026-trails)
AGENT_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEMINI_API_KEY=

# Browser-visible service addresses
VITE_API_BASE_URL=http://localhost:8080
VITE_AGENT_BASE_URL=http://localhost:8000

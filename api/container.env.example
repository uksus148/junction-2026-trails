# Copy to the ignored root .env.api-container and fill values privately.
# docker --env-file uses literal values: no quotes, shell expansion or ${...} references.
SPRING_DATASOURCE_URL=jdbc:postgresql://<aiven-host>:<aiven-port>/<database>?sslmode=verify-full&sslrootcert=/run/certs/aiven-ca.pem
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_DATA_REDIS_URL=rediss://default:<url-encoded-password>@<aiven-valkey-host>:<port>
ORS_API_KEY=
ORS_BASE_URL=https://api.heigit.org/openrouteservice
API_CORS_ALLOWED_ORIGINS=http://localhost:5173
